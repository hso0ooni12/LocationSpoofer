+                        SpoofBackend.current = .developer
+                        session.teleport(to: chosenLocation, pairing: pairing)
+                    } label: {
+                        HStack(spacing: 9) {
+                            if session.isBusy { ProgressView().tint(.white) }
+                            else { Image(systemName: "location.fill") }
+                            Text(tr("تفعيل الموقع المختار", "Activate selected location"))
+                        }
+                        .font(.system(size: 15, weight: .bold))
+                        .frame(maxWidth: .infinity)
+                        .frame(height: 54)
+                    }
+                    .buttonStyle(.borderedProminent)
+                    .tint(blue)
