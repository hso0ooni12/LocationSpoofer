+    private func sectionTitle(_ title: String, symbol: String) -> some View {
+        Label(title, systemImage: symbol)
+            .font(.system(size: 15, weight: .bold, design: .rounded))
+    }
+
+    private func initialize() {
+        // XS offers one method, regardless of any older Locus preference.
+        LocationBackend.prefersDirect = false
+        SpoofBackend.current = .developer
+        refresh()
+    }
+
+    private func refresh() {
+        pairing.refresh()
+        vpnUp = TunnelController.loopbackReachable
+    }
+
+    @MainActor
+    private func searchPlace() async {
+        let query = searchText.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty else { return }
+        if let found = CoordinateParser.parse(query) {
+            showOnMap(found.coordinate)
+            return
+        }
+        searching = true
+        defer { searching = false }
+        let request = MKLocalSearch.Request()
+        request.naturalLanguageQuery = query
+        do {
+            let result = try await MKLocalSearch(request: request).start()
+            guard let coordinate = result.mapItems.first?.placemark.coordinate else {
+                searchError = tr("ما حصلت نتيجة؛ جرّب اسم مدينة أخرى", "No result. Try another city or address.")
+                return
+            }
+            showOnMap(coordinate)
+        } catch {
+            searchError = error.localizedDescription
+        }
+    }
+
+    private func showOnMap(_ coordinate: CLLocationCoordinate2D) {
+        session.setPin(coordinate)
+        camera = .region(MKCoordinateRegion(center: coordinate,
+            span: MKCoordinateSpan(latitudeDelta: 0.02, longitudeDelta: 0.02)))
+        searchFocused = false
+    }
+}
