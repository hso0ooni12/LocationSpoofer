diff --git a/Locus/Features/XS/XSPairOnDeviceView.swift b/Locus/Features/XS/XSPairOnDeviceView.swift
new file mode 100644
index 0000000..c6880e6
--- /dev/null
+++ b/Locus/Features/XS/XSPairOnDeviceView.swift
@@ -0,0 +1,201 @@
+import SwiftUI
+
+/// XS Location's iOS 27 pairing wizard. The host starts advertising as soon as
+/// this sheet opens; iOS still requires the owner to approve the six-digit code.
+struct XSPairOnDeviceView: View {
+    @EnvironmentObject private var pairing: PairingStore
+    @Environment(\.dismiss) private var dismiss
+
+    @StateObject private var host = PairOnDeviceService()
+    @State private var started = false
+
+    let arabic: Bool
+
+    private let blue = Color(red: 0.22, green: 0.38, blue: 0.88)
+    private let mint = Color(red: 0.07, green: 0.65, blue: 0.52)
+    private var surface: Color { Color(uiColor: .secondarySystemGroupedBackground) }
+
+    private func tr(_ ar: String, _ en: String) -> String { arabic ? ar : en }
+
+    var body: some View {
+        NavigationStack {
+            ScrollView(showsIndicators: false) {
+                VStack(alignment: .leading, spacing: 18) {
+                    introduction
+                    statusCard
+                    instructions
+                    footnote
+                }
+                .padding(20)
+                .frame(maxWidth: 570)
+                .frame(maxWidth: .infinity)
+            }
+            .background(Color(uiColor: .systemGroupedBackground).ignoresSafeArea())
+            .navigationTitle(tr("الاقتران", "Device pairing"))
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) {
+                    Button(tr("إغلاق", "Close")) {
+                        host.resetToIdle()
+                        dismiss()
+                    }
+                }
+            }
+        }
+        .environment(\.layoutDirection, arabic ? .rightToLeft : .leftToRight)
+        .onAppear {
+            guard !started else { return }
+            started = true
+            host.start(pairingStore: pairing, name: "XS Location")
+        }
+        .onChange(of: host.phase) { _, phase in
+            if case .succeeded = phase {
+                pairing.refresh()
+            }
+        }
+        .onDisappear {
+            if host.isBusy { host.resetToIdle() }
+        }
+    }
+
+    private var introduction: some View {
+        HStack(alignment: .top, spacing: 13) {
+            Image(systemName: "iphone.gen3.radiowaves.left.and.right")
+                .font(.system(size: 26, weight: .semibold))
+                .foregroundStyle(blue)
+                .frame(width: 54, height: 54)
+                .background(blue.opacity(0.10), in: RoundedRectangle(cornerRadius: 16))
+
+            VStack(alignment: .leading, spacing: 6) {
+                Text(tr("بدون كمبيوتر وبدون استيراد ملف", "No computer or file import"))
+                    .font(.system(size: 19, weight: .bold, design: .rounded))
+                Text(tr("بدأ XS Location تجهيز الاقتران تلقائيًا. بقي تأكيدك من إعدادات iOS، وبعدها تُحفظ بيانات الربط داخل التطبيق.",
+                        "XS Location starts pairing automatically. Approve it in iOS Settings; the pairing data is then saved inside the app."))
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+        }
+    }
+
+    private var statusCard: some View {
+        VStack(spacing: 13) {
+            switch host.phase {
+            case .idle, .advertising:
+                ProgressView().tint(blue)
+                Text(tr("بانتظار موافقتك من الإعدادات", "Waiting for approval in Settings"))
+                    .font(.headline)
+                Text(tr("افتح وضع المطوّر واختر الاقتران مع XS Location.",
+                        "Open Developer Mode and choose to pair with XS Location."))
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+                    .multilineTextAlignment(.center)
+
+            case .deviceConnected:
+                ProgressView().tint(blue)
+                Text(tr("تم الاتصال بالآيفون", "Connected to this iPhone"))
+                    .font(.headline)
+                Text(tr("جاري إنشاء رمز من ٦ أرقام…", "Generating your six-digit code…"))
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+
+            case .awaitingPIN(let pin):
+                Image(systemName: "number.square.fill")
+                    .font(.system(size: 30))
+                    .foregroundStyle(blue)
+                Text(tr("اكتب هذا الرمز في الإعدادات", "Enter this code in Settings"))
+                    .font(.headline)
+                Text(pin)
+                    .font(.system(size: 43, weight: .bold, design: .rounded))
+                    .tracking(7)
+                    .monospacedDigit()
+                    .textSelection(.enabled)
+                    .environment(\.layoutDirection, .leftToRight)
+                Text(tr("بعد إدخال رمز قفل الجهاز، سيطلب النظام رمز الاقتران هذا.",
+                        "After your device passcode, iOS will ask for this pairing code."))
+                    .font(.caption)
+                    .foregroundStyle(.secondary)
+                    .multilineTextAlignment(.center)
+
+            case .succeeded:
+                Image(systemName: "checkmark.seal.fill")
+                    .font(.system(size: 38))
+                    .foregroundStyle(mint)
+                Text(tr("تم الاقتران بنجاح", "Paired successfully"))
+                    .font(.title3.bold())
+                Text(tr("انحفظ الربط تلقائيًا. ارجع للصفحة الرئيسية وشغّل LocalDevVPN.",
+                        "Pairing was saved automatically. Return to the main screen and connect LocalDevVPN."))
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+                    .multilineTextAlignment(.center)
+                Button(tr("العودة للتطبيق", "Back to XS Location")) { dismiss() }
+                    .buttonStyle(.borderedProminent)
+                    .tint(blue)
+
+            case .failed(let reason):
+                Image(systemName: "exclamationmark.triangle.fill")
+                    .font(.system(size: 36))
+                    .foregroundStyle(.orange)
+                Text(tr("تعذّر الاقتران", "Pairing failed"))
+                    .font(.headline)
+                Text(reason)
+                    .font(.caption)
+                    .foregroundStyle(.secondary)
+                    .multilineTextAlignment(.center)
+                    .textSelection(.enabled)
+                Button(tr("إعادة المحاولة", "Try again")) {
+                    host.acknowledgeFailure()
+                    host.start(pairingStore: pairing, name: "XS Location")
+                }
+                .buttonStyle(.borderedProminent)
+                .tint(blue)
+            }
+        }
+        .frame(maxWidth: .infinity)
+        .padding(22)
+        .background(surface, in: RoundedRectangle(cornerRadius: 22))
+        .accessibilityElement(children: .contain)
+    }
+
+    private var instructions: some View {
+        VStack(alignment: .leading, spacing: 14) {
+            Text(tr("خطوات تأكيد الاقتران", "Approve pairing in four steps"))
+                .font(.headline)
+            numbered(1, tr("خل XS Location يعمل بالخلفية، واسمح بالشبكة المحلية والإشعارات إذا طلبها.",
+                            "Keep XS Location running and allow Local Network and notifications if prompted."))
+            numbered(2, tr("افتح الإعدادات ← الخصوصية والأمان ← وضع المطوّر.",
+                            "Open Settings → Privacy & Security → Developer Mode."))
+            numbered(3, tr("اضغط Pair with XS Location (أو Pair with Host) ثم Pair.",
+                            "Tap Pair with XS Location (or Pair with Host), then Pair."))
+            numbered(4, tr("أدخل رمز قفل الجهاز، ثم رمز الاقتران المكوّن من ٦ أرقام الذي يظهر هنا أو في الإشعار.",
+                            "Enter your device passcode, then the six-digit code shown here or in the notification."))
+        }
+        .padding(18)
+        .background(surface, in: RoundedRectangle(cornerRadius: 22))
+    }
+
+    private func numbered(_ number: Int, _ description: String) -> some View {
+        HStack(alignment: .top, spacing: 12) {
+            Text("\(number)")
+                .font(.caption.bold())
+                .foregroundStyle(blue)
+                .frame(width: 27, height: 27)
+                .background(blue.opacity(0.10), in: Circle())
+            Text(description)
+                .font(.subheadline)
+                .fixedSize(horizontal: false, vertical: true)
+            Spacer(minLength: 0)
+        }
+    }
+
+    private var footnote: some View {
+        Label(
+            tr("هذه الخطوة تنشئ بيانات الاقتران تلقائيًا بعد موافقتك. نظام iOS ما يسمح لنا بتجاوز الموافقة أو رمز الأمان.",
+               "Pairing data is generated after your approval. iOS requires you to confirm the pairing and security code."),
+            systemImage: "lock.shield"
+        )
+        .font(.caption)
+        .foregroundStyle(.secondary)
+        .fixedSize(horizontal: false, vertical: true)
+    }
+}
