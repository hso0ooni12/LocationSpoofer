diff --git a/Locus/Features/XS/XSRootView.swift b/Locus/Features/XS/XSRootView.swift
new file mode 100644
index 0000000..d519008
--- /dev/null
+++ b/Locus/Features/XS/XSRootView.swift
@@ -0,0 +1,741 @@
+import CoreLocation
+import MapKit
+import SwiftUI
+import UniformTypeIdentifiers
+
+/// XS Location deliberately has only two user-facing methods.  The underlying
+/// Locus engines remain intact; this is a guided front end, not a fake demo.
+struct XSRootView: View {
+    @EnvironmentObject private var session: SpoofSession
+    @EnvironmentObject private var pairing: PairingStore
+    @Environment(\.scenePhase) private var scenePhase
+
+    @StateObject private var network = NetworkSpoofer.shared
+    @StateObject private var identity = InterceptIdentity.shared
+
+    @AppStorage("xs.language") private var language = "ar"
+    @AppStorage("xs.satellite") private var satellite = false
+    @State private var method: SpoofBackend = .developer
+    @State private var camera = MapCameraPosition.region(
+        MKCoordinateRegion(
+            center: CLLocationCoordinate2D(latitude: 25.38, longitude: 49.59),
+            span: MKCoordinateSpan(latitudeDelta: 0.055, longitudeDelta: 0.055)
+        )
+    )
+    @State private var searchText = ""
+    @State private var searching = false
+    @State private var searchError: String?
+    @State private var showImporter = false
+    @State private var showNetworkSetup = false
+    @State private var showAdvanced = false
+    @State private var vpnUp = TunnelController.loopbackReachable
+
+    @FocusState private var searchFocused: Bool
+
+    private let blue = Color(red: 0.22, green: 0.38, blue: 0.88)
+    private let mint = Color(red: 0.07, green: 0.65, blue: 0.52)
+    private var ar: Bool { language == "ar" }
+    private func tr(_ arabic: String, _ english: String) -> String { ar ? arabic : english }
+    private var locked: Bool { session.isSpoofing || session.isBusy }
+    private var chosenLocation: CLLocationCoordinate2D? { session.pin }
+    private var surface: Color { Color(uiColor: .secondarySystemGroupedBackground) }
+
+    var body: some View {
+        NavigationStack {
+            ZStack {
+                Color(uiColor: .systemGroupedBackground).ignoresSafeArea()
+                ScrollView(showsIndicators: false) {
+                    VStack(alignment: .leading, spacing: 19) {
+                        header
+                        introduction
+                        methodSelector
+                        mapCard
+                        setupCard
+                        limitationNote
+                    }
+                    .padding(.horizontal, 19)
+                    .padding(.top, 12)
+                    .padding(.bottom, 28)
+                }
+            }
+            .toolbar(.hidden, for: .navigationBar)
+            .safeAreaInset(edge: .bottom, spacing: 0) { actionBar }
+            .environment(\.layoutDirection, ar ? .rightToLeft : .leftToRight)
+            .sheet(isPresented: $showNetworkSetup) { XSCertificateView(arabic: ar) }
+            .sheet(isPresented: $showAdvanced) { XSAdvancedView(arabic: ar) }
+            .fileImporter(
+                isPresented: $showImporter,
+                allowedContentTypes: PairingStore.supportedTypes,
+                allowsMultipleSelection: false
+            ) { result in
+                switch result {
+                case .success(let urls):
+                    guard let url = urls.first else { return }
+                    do { try pairing.importPairing(from: url) }
+                    catch { pairing.lastError = error.localizedDescription }
+                case .failure(let error):
+                    pairing.lastError = error.localizedDescription
+                }
+            }
+            .alert(tr("تعذّر إكمال العملية", "Couldn't finish"), isPresented: Binding(
+                get: { session.lastError != nil || pairing.lastError != nil || searchError != nil },
+                set: { if !$0 { session.lastError = nil; pairing.lastError = nil; searchError = nil } }
+            )) {
+                Button(tr("حسناً", "OK"), role: .cancel) {
+                    session.lastError = nil
+                    pairing.lastError = nil
+                    searchError = nil
+                }
+            } message: {
+                Text(session.lastError ?? pairing.lastError ?? searchError ?? "")
+            }
+            .onAppear { initialize() }
+            .onChange(of: scenePhase) { _, phase in
+                if phase == .active { refresh() }
+            }
+            .onReceive(NotificationCenter.default.publisher(for: .locusOpenLocation)) { notification in
+                guard let link = notification.object as? LocusLocationLink else { return }
+                showOnMap(link.match.coordinate)
+                if link.teleports, !locked {
+                    SpoofBackend.current = method
+                    session.teleport(to: link.match.coordinate, pairing: pairing)
+                }
+            }
+        }
+    }
+
+    // MARK: - Identity & method selection
+
+    private var header: some View {
+        HStack(spacing: 12) {
+            ZStack {
+                RoundedRectangle(cornerRadius: 17, style: .continuous)
+                    .fill(LinearGradient(colors: [blue, mint], startPoint: .topLeading, endPoint: .bottomTrailing))
+                Image(systemName: "location.north.circle.fill")
+                    .font(.system(size: 27, weight: .medium))
+                    .foregroundStyle(.white)
+            }
+            .frame(width: 52, height: 52)
+
+            VStack(alignment: .leading, spacing: 2) {
+                Text("XS Location")
+                    .font(.system(size: 23, weight: .bold, design: .rounded))
+                Text(tr("موقعك، على كيفك", "Choose where to test"))
+                    .font(.system(size: 12, weight: .medium))
+                    .foregroundStyle(.secondary)
+            }
+            Spacer(minLength: 5)
+            Button {
+                language = ar ? "en" : "ar"
+            } label: {
+                Text(ar ? "EN" : "عربي")
+                    .font(.system(size: 13, weight: .semibold))
+                    .frame(minWidth: 43, minHeight: 37)
+                    .background(surface, in: Capsule())
+            }
+            .buttonStyle(.plain)
+            .accessibilityLabel(tr("تغيير اللغة", "Change language"))
+        }
+    }
+
+    private var introduction: some View {
+        HStack(spacing: 12) {
+            VStack(alignment: .leading, spacing: 8) {
+                Text(tr("اختر الطريقة المناسبة لجهازك", "Pick the best method for your iPhone"))
+                    .font(.system(size: 19, weight: .bold, design: .rounded))
+                    .fixedSize(horizontal: false, vertical: true)
+                Text(tr("طريقتان، وخطوات واضحة. تقدر تغيّر الاختيار قبل تشغيل الموقع.",
+                        "Two methods, one clear setup. Switch methods before starting."))
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+            Spacer(minLength: 0)
+            statusBadge
+        }
+    }
+
+    private var statusBadge: some View {
+        let pendingNetwork = method == .network && session.isSpoofing && !network.hasTakenEffect
+        let label = session.isBusy ? tr("جاري العمل", "Working")
+            : pendingNetwork ? tr("بانتظار النظام", "Waiting for iOS")
+            : session.isSpoofing ? tr("نشط", "Active") : tr("متوقف", "Off")
+        let color = session.isSpoofing && !pendingNetwork ? mint : pendingNetwork ? Color.orange : Color.secondary
+        return HStack(spacing: 5) {
+            Circle().fill(color).frame(width: 7, height: 7)
+            Text(label).font(.system(size: 11, weight: .semibold))
+        }
+        .padding(.horizontal, 10)
+        .padding(.vertical, 9)
+        .background(surface, in: Capsule())
+        .fixedSize()
+    }
+
+    private var methodSelector: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            sectionTitle(tr("طريقة التشغيل", "Connection method"), symbol: "square.stack.3d.up")
+            HStack(spacing: 10) {
+                methodCard(
+                    .developer,
+                    title: tr("LocalDevVPN", "LocalDevVPN"),
+                    subtitle: tr("الموقع الكامل", "System location"),
+                    explanation: tr("يتطلب Pairing", "Requires Pairing"),
+                    symbol: "iphone.gen3.radiowaves.left.and.right"
+                )
+                methodCard(
+                    .network,
+                    title: tr("Network", "Network"),
+                    subtitle: tr("واي فاي وأبراج", "Wi-Fi & cellular"),
+                    explanation: tr("بدون Pairing", "No Pairing file"),
+                    symbol: "network"
+                )
+            }
+        }
+    }
+
+    private func methodCard(_ candidate: SpoofBackend, title: String, subtitle: String, explanation: String, symbol: String) -> some View {
+        let chosen = method == candidate
+        return Button {
+            guard !locked else { return }
+            method = candidate
+            SpoofBackend.current = candidate
+            refresh()
+        } label: {
+            VStack(alignment: .leading, spacing: 7) {
+                HStack {
+                    Image(systemName: symbol)
+                        .font(.system(size: 20, weight: .medium))
+                        .foregroundStyle(chosen ? blue : Color.secondary)
+                    Spacer()
+                    Image(systemName: chosen ? "checkmark.circle.fill" : "circle")
+                        .foregroundStyle(chosen ? blue : Color(uiColor: .tertiaryLabel))
+                }
+                .padding(.bottom, 4)
+                Text(title)
+                    .font(.system(size: 16, weight: .bold, design: .rounded))
+                    .foregroundStyle(.primary)
+                    .lineLimit(1)
+                    .minimumScaleFactor(0.8)
+                Text(subtitle)
+                    .font(.system(size: 12, weight: .semibold))
+                    .foregroundStyle(.primary)
+                Text(explanation)
+                    .font(.system(size: 11))
+                    .foregroundStyle(.secondary)
+            }
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .padding(15)
+            .background(chosen ? blue.opacity(0.07) : surface, in: RoundedRectangle(cornerRadius: 20))
+            .overlay {
+                RoundedRectangle(cornerRadius: 20)
+                    .strokeBorder(chosen ? blue.opacity(0.7) : Color.clear, lineWidth: 1.5)
+            }
+        }
+        .buttonStyle(.plain)
+        .disabled(locked)
+        .accessibilityAddTraits(chosen ? .isSelected : [])
+    }
+
+    // MARK: - Map
+
+    private var mapCard: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            HStack {
+                sectionTitle(tr("حدد المكان", "Choose a location"), symbol: "mappin.circle")
+                Spacer()
+                Button {
+                    satellite.toggle()
+                } label: {
+                    Label(satellite ? tr("عادية", "Standard") : tr("قمر صناعي", "Satellite"),
+                          systemImage: satellite ? "map" : "globe.europe.africa")
+                        .font(.system(size: 12, weight: .semibold))
+                }
+                .buttonStyle(.plain)
+            }
+
+            HStack(spacing: 8) {
+                Image(systemName: "magnifyingglass").foregroundStyle(.secondary)
+                TextField(tr("ابحث عن مدينة أو عنوان", "Search a city or address"), text: $searchText)
+                    .textInputAutocapitalization(.never)
+                    .autocorrectionDisabled()
+                    .submitLabel(.search)
+                    .focused($searchFocused)
+                    .onSubmit { Task { await searchPlace() } }
+                    .font(.subheadline)
+                if searching { ProgressView().controlSize(.small) }
+                else if !searchText.isEmpty {
+                    Button { Task { await searchPlace() } } label: {
+                        Image(systemName: "arrow.up.circle.fill")
+                            .font(.system(size: 23))
+                            .foregroundStyle(blue)
+                    }
+                    .accessibilityLabel(tr("بحث", "Search"))
+                }
+            }
+            .padding(.horizontal, 13)
+            .frame(height: 46)
+            .background(Color(uiColor: .tertiarySystemGroupedBackground), in: RoundedRectangle(cornerRadius: 14))
+
+            MapReader { mapProxy in
+                Map(position: $camera) {
+                    if let chosenLocation {
+                        Annotation(tr("المكان المختار", "Selected"), coordinate: chosenLocation) {
+                            Image(systemName: "mappin.circle.fill")
+                                .symbolRenderingMode(.palette)
+                                .foregroundStyle(.white, blue)
+                                .font(.system(size: 37))
+                                .shadow(color: .black.opacity(0.2), radius: 5, y: 3)
+                        }
+                    }
+                }
+                .mapStyle(satellite ? .imagery : .standard)
+                .mapControls { MapCompass() }
+                .onTapGesture(coordinateSpace: .local) { point in
+                    guard let coordinate = mapProxy.convert(point, from: .local) else { return }
+                    searchFocused = false
+                    session.setPin(coordinate)
+                }
+            }
+            .frame(height: 265)
+            .clipShape(RoundedRectangle(cornerRadius: 18))
+            .overlay(RoundedRectangle(cornerRadius: 18).strokeBorder(.primary.opacity(0.05)))
+
+            HStack(spacing: 9) {
+                Image(systemName: chosenLocation == nil ? "hand.tap" : "location.fill")
+                    .foregroundStyle(blue)
+                VStack(alignment: .leading, spacing: 3) {
+                    Text(chosenLocation == nil ? tr("اضغط على الخريطة لتحديد موقع", "Tap the map to drop a pin")
+                         : session.pinAddress ?? tr("الموقع المختار", "Selected location"))
+                        .font(.system(size: 12, weight: .semibold))
+                        .lineLimit(2)
+                    if let coordinate = chosenLocation {
+                        Text(String(format: "%.6f, %.6f", coordinate.latitude, coordinate.longitude))
+                            .font(.system(size: 11, design: .monospaced))
+                            .foregroundStyle(.secondary)
+                            .environment(\.layoutDirection, .leftToRight)
+                    }
+                }
+                Spacer(minLength: 0)
+            }
+            .padding(.vertical, 4)
+        }
+        .padding(15)
+        .background(surface, in: RoundedRectangle(cornerRadius: 24, style: .continuous))
+    }
+
+    // MARK: - Guided setup
+
+    private var setupCard: some View {
+        VStack(alignment: .leading, spacing: 14) {
+            sectionTitle(tr("التجهيز — خطوة بخطوة", "Setup — step by step"), symbol: "list.number")
+            if method == .developer {
