+                    "Note: some apps detect or reject simulated locations. Pairing and VPN connection do not guarantee that a target app accepts the new location."))
+                .font(.system(size: 12))
+                .foregroundStyle(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+        }
+        .padding(13)
