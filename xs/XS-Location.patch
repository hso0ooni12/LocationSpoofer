@@ -0,0 +1,580 @@
+import CoreLocation
+import MapKit
+import SwiftUI
+import UniformTypeIdentifiers
+
+/// A single, adaptive LocalDevVPN experience for iPhone and iPad.
+/// The Locus engine stays intact; network spoofing is not user-selectable.
+struct XSRootView: View {
+    @EnvironmentObject private var session: SpoofSession
+    @EnvironmentObject private var pairing: PairingStore
+    @Environment(\.scenePhase) private var scenePhase
+
+    @AppStorage("xs.language") private var language = "ar"
+    @AppStorage("xs.satellite") private var satellite = false
+    @State private var camera = MapCameraPosition.region(
+        MKCoordinateRegion(
+            center: CLLocationCoordinate2D(latitude: 25.38, longitude: 49.59),
+            span: MKCoordinateSpan(latitudeDelta: 0.055, longitudeDelta: 0.055)
+        )
+    )
+    @State private var searchText = ""
+    @State private var searching = false
+    @State private var searchError: String?
+    @State private var showImporter = false
+    @State private var showOnDevicePairing = false
+    @State private var showAdvanced = false
+    @State private var vpnUp = TunnelController.loopbackReachable
+
+    @FocusState private var searchFocused: Bool
+
+    private let blue = Color(red: 0.22, green: 0.38, blue: 0.88)
+    private let mint = Color(red: 0.07, green: 0.65, blue: 0.52)
+    private var ar: Bool { language == "ar" }
+    private func tr(_ arabic: String, _ english: String) -> String { ar ? arabic : english }
+    private var locked: Bool { session.isSpoofing || session.isBusy }
+    private var chosenLocation: CLLocationCoordinate2D? { session.pin }
+    private var surface: Color { Color(uiColor: .secondarySystemGroupedBackground) }
+
+    var body: some View {
+        NavigationStack {
+            GeometryReader { geometry in
+                ScrollView(showsIndicators: false) {
+                    pageContent(in: geometry.size)
+                        .frame(maxWidth: 1280)
+                        .frame(maxWidth: .infinity)
+                        .padding(.horizontal, UIDevice.current.userInterfaceIdiom == .pad ? 26 : 16)
+                        .padding(.top, 14)
+                        .padding(.bottom, 32)
+                }
+                .background(Color(uiColor: .systemGroupedBackground).ignoresSafeArea())
+            }
+            .toolbar(.hidden, for: .navigationBar)
+            .safeAreaInset(edge: .bottom, spacing: 0) { actionBar }
+            .environment(\.layoutDirection, ar ? .rightToLeft : .leftToRight)
+            .sheet(isPresented: $showOnDevicePairing) {
+                XSPairOnDeviceView(arabic: ar)
+                    .environmentObject(pairing)
+            }
+            .sheet(isPresented: $showAdvanced) { XSAdvancedView(arabic: ar) }
+            .fileImporter(
+                isPresented: $showImporter,
+                allowedContentTypes: PairingStore.supportedTypes,
+                allowsMultipleSelection: false
+            ) { result in
+                switch result {
+                case .success(let urls):
+                    guard let url = urls.first else { return }
+                    do { try pairing.importPairing(from: url) }
+                    catch { pairing.lastError = error.localizedDescription }
+                case .failure(let error):
+                    pairing.lastError = error.localizedDescription
+                }
+            }
+            .alert(tr("تعذّر إكمال العملية", "Couldn't finish"), isPresented: Binding(
+                get: { session.lastError != nil || pairing.lastError != nil || searchError != nil },
+                set: { if !$0 { session.lastError = nil; pairing.lastError = nil; searchError = nil } }
+            )) {
+                Button(tr("حسناً", "OK"), role: .cancel) {
+                    session.lastError = nil
+                    pairing.lastError = nil
+                    searchError = nil
+                }
+            } message: {
+                Text(session.lastError ?? pairing.lastError ?? searchError ?? "")
+            }
+            .onAppear { initialize() }
+            .onChange(of: scenePhase) { _, phase in
+                if phase == .active { refresh() }
+            }
+            .onReceive(NotificationCenter.default.publisher(for: .locusOpenLocation)) { notification in
+                guard let link = notification.object as? LocusLocationLink else { return }
+                showOnMap(link.match.coordinate)
+                if link.teleports, !locked {
+                    SpoofBackend.current = .developer
+                    session.teleport(to: link.match.coordinate, pairing: pairing)
+                }
+            }
+        }
+    }
+
+    @ViewBuilder
+    private func pageContent(in size: CGSize) -> some View {
+        let isPad = UIDevice.current.userInterfaceIdiom == .pad
+        let isWidePad = isPad && size.width >= 980
+        let mapHeight = min(max(size.height * (isPad ? 0.69 : 0.53), isPad ? 520 : 385), isPad ? 780 : 570)
+
+        VStack(alignment: .leading, spacing: 20) {
+            header
+            introduction
+
+            if isWidePad {
+                HStack(alignment: .top, spacing: 20) {
+                    mapCard(height: mapHeight)
+                        .frame(maxWidth: .infinity)
+                    VStack(alignment: .leading, spacing: 15) {
+                        setupCard
+                        limitationNote
+                    }
+                    .frame(width: min(size.width * 0.33, 375))
+                }
+            } else {
+                mapCard(height: mapHeight)
+                setupCard
+                limitationNote
+            }
+        }
+    }
+
