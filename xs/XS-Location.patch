diff --git a/.github/workflows/build-xs-ipa.yml b/.github/workflows/build-xs-ipa.yml
new file mode 100644
index 0000000..52f1152
--- /dev/null
+++ b/.github/workflows/build-xs-ipa.yml
@@ -0,0 +1,65 @@
+name: XS Location — Unsigned IPA
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  ipa:
+    runs-on: macos-26
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: maxim-lobanov/setup-xcode@v1
+        with:
+          xcode-version: latest-stable
+
+      - name: Install XcodeGen
+        env:
+          HOMEBREW_NO_AUTO_UPDATE: "1"
+        run: brew install xcodegen
+
+      - name: Generate native Xcode project
+        run: xcodegen generate
+
+      - name: Build both engines and extensions
+        run: |
+          set -euo pipefail
+          xcodebuild archive \
+            -project Locus.xcodeproj \
+            -scheme Locus \
+            -configuration Release \
+            -sdk iphoneos \
+            -destination 'generic/platform=iOS' \
+            -archivePath build/XS-Location.xcarchive \
+            CODE_SIGN_IDENTITY='' \
+            CODE_SIGNING_ALLOWED=NO \
+            CODE_SIGNING_REQUIRED=NO \
+            CODE_SIGN_ENTITLEMENTS='' \
+            DEVELOPMENT_TEAM='' \
+            SKIP_INSTALL=NO
+
+      - name: Package and verify unsigned IPA
+        run: |
+          set -euo pipefail
+          APP='build/XS-Location.xcarchive/Products/Applications/Locus.app'
+          test -f "$APP/Locus"
+          test -f "$APP/PlugIns/LocusTunnel.appex/LocusTunnel"
+          test -f "$APP/PlugIns/LocusWidgets.appex/LocusWidgets"
+          test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$APP/Info.plist")" = 'XS Location'
+          test "$(/usr/libexec/PlistBuddy -c 'Print :NSExtension:NSExtensionPointIdentifier' "$APP/PlugIns/LocusTunnel.appex/Info.plist")" = 'com.apple.networkextension.packet-tunnel'
+          mkdir -p Payload
+          cp -R "$APP" Payload/
+          zip -qry XS-Location-unsigned.ipa Payload
+          unzip -t XS-Location-unsigned.ipa
+          ls -lh XS-Location-unsigned.ipa
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: XS-Location-unsigned-IPA
+          path: XS-Location-unsigned.ipa
+          if-no-files-found: error
+          retention-days: 30
