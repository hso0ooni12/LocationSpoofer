+/// The normal person only needs three certificate steps. Keep the original
+/// NetworkModeView available for diagnostics, but out of the first-run flow.
+private struct XSCertificateView: View {
+    let arabic: Bool
+
+    @Environment(\.dismiss) private var dismiss
+    @Environment(\.scenePhase) private var scenePhase
+    @StateObject private var identity = InterceptIdentity.shared
+    @State private var shareFile: URL?
+    @State private var errorMessage: String?
+    @State private var preparing = false
+    @State private var showDetails = false
+
+    private let blue = Color(red: 0.22, green: 0.38, blue: 0.88)
+    private let mint = Color(red: 0.07, green: 0.65, blue: 0.52)
+    private func tr(_ ar: String, _ en: String) -> String { arabic ? ar : en }
+
+    var body: some View {
+        NavigationStack {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 18) {
+                    HStack(spacing: 11) {
+                        Image(systemName: identity.trust == .trusted ? "checkmark.shield.fill" : "lock.shield")
+                            .font(.system(size: 27))
+                            .foregroundStyle(identity.trust == .trusted ? mint : blue)
+                        VStack(alignment: .leading, spacing: 5) {
+                            Text(tr("شهادة الاتصال", "Network certificate"))
+                                .font(.system(size: 21, weight: .bold))
+                            Text(identity.trust == .trusted
+                                 ? tr("مُثبّتة وموثوقة ✅", "Installed and trusted ✅")
+                                 : tr("جهّزها مرة واحدة على كل جهاز", "Set this up once per device"))
+                                .font(.subheadline).foregroundStyle(.secondary)
+                        }
+                    }
+
+                    certificateStep(1, title: tr("نزّل الشهادة", "Download the certificate"),
+                                    detail: tr("افتح Safari واسمح بتحميل ملف الشهادة.", "Open Safari and allow the certificate download.")) {
+                        Button {
+                            Task { await install() }
+                        } label: {
+                            HStack(spacing: 7) {
+                                if preparing { ProgressView().tint(.white) }
+                                Image(systemName: "square.and.arrow.down")
+                                Text(tr("تحميل الشهادة", "Download certificate"))
+                            }
+                        }
+                        .buttonStyle(.borderedProminent).tint(blue)
+                        .disabled(preparing)
+                    }
+
+                    certificateStep(2, title: tr("ثبّت ملف التعريف", "Install the profile"),
+                                    detail: tr("الإعدادات ← عام ← VPN وإدارة الجهاز ← الملف الذي تم تنزيله ← تثبيت.",
+                                               "Settings → General → VPN & Device Management → Downloaded Profile → Install.")) {
+                        Button(tr("فتح الإعدادات", "Open Settings")) { openSettings() }
+                            .buttonStyle(.bordered)
+                    }
+
+                    certificateStep(3, title: tr("فعّل الثقة بالشهادة", "Trust the certificate"),
+                                    detail: tr("الإعدادات ← عام ← حول ← إعدادات الوثوق بالشهادات، ثم فعّل شهادة XS Location.",
+                                               "Settings → General → About → Certificate Trust Settings → enable the XS Location certificate.")) {
+                        Button {
+                            identity.refreshTrust()
+                            prepareShareFile()
+                        } label: {
+                            Label(tr("التحقق من الثقة", "Check certificate trust"), systemImage: "checkmark.shield")
+                        }
+                        .buttonStyle(.bordered)
+                    }
+
+                    if let errorMessage {
+                        Label(errorMessage, systemImage: "exclamationmark.triangle")
+                            .font(.footnote).foregroundStyle(.orange)
+                    }
+
+                    if let shareFile {
+                        ShareLink(item: shareFile) {
+                            Label(tr("مشاركة ملف الشهادة", "Share certificate file"), systemImage: "square.and.arrow.up")
+                                .font(.subheadline)
+                        }
+                    }
+
+                    Button {
+                        showDetails = true
+                    } label: {
+                        Label(tr("اختبارات الشبكة والتفاصيل التقنية", "Network checks and advanced details"),
+                              systemImage: "wrench.adjustable")
+                            .font(.subheadline)
+                    }
+
+                    Text(tr("تنبيه خصوصية: الوثوق بشهادة جذرية قرار حساس. استخدم التطبيق من مصدر تثق فيه، واحذف الشهادة من إعدادات iOS متى ما انتهيت.",
+                            "Privacy note: trusting a root certificate is sensitive. Use only trusted builds, and remove the certificate in iOS Settings when finished."))
+                        .font(.caption).foregroundStyle(.secondary)
+                }
+                .padding(20)
+            }
+            .background(Color(uiColor: .systemGroupedBackground))
+            .navigationTitle(tr("الإعداد السريع", "Quick setup"))
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .confirmationAction) {
+                    Button(tr("تم", "Done")) { dismiss() }
+                }
+            }
+            .environment(\.layoutDirection, arabic ? .rightToLeft : .leftToRight)
+            .sheet(isPresented: $showDetails) { NetworkModeView() }
+            .onAppear {
+                identity.refreshTrust()
+                prepareShareFile()
+            }
+            .onChange(of: scenePhase) { _, phase in
+                if phase == .active { identity.refreshTrust() }
+            }
+        }
+    }
+
+    private func certificateStep<Accessory: View>(
+        _ number: Int, title: String, detail: String,
+        @ViewBuilder accessory: () -> Accessory
+    ) -> some View {
+        HStack(alignment: .top, spacing: 11) {
+            Text("\(number)")
+                .font(.system(size: 14, weight: .bold))
+                .foregroundStyle(blue)
+                .frame(width: 29, height: 29)
+                .background(blue.opacity(0.10), in: Circle())
+            VStack(alignment: .leading, spacing: 9) {
+                Text(title).font(.system(size: 15, weight: .bold))
+                Text(detail).font(.subheadline).foregroundStyle(.secondary)
+                    .fixedSize(horizontal: false, vertical: true)
+                accessory()
+            }
+            Spacer(minLength: 0)
+        }
+        .padding(16)
+        .background(Color(uiColor: .secondarySystemGroupedBackground),
+                    in: RoundedRectangle(cornerRadius: 19))
+    }
+
+    @MainActor
+    private func install() async {
+        preparing = true
+        defer { preparing = false }
+        errorMessage = nil
+        do {
+            try identity.ensureCreated()
+            prepareShareFile()
+            guard let der = identity.authorityCertificate,
+                  let url = await CertificateServer.shared.publish(der) else {
+                errorMessage = tr("تعذر فتح Safari. جرب مشاركة الشهادة وحفظها في الملفات.",
+                                  "Safari couldn't open the download. Try sharing the certificate to Files.")
+                return
+            }
+            await UIApplication.shared.open(url)
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    private func prepareShareFile() {
+        guard let der = identity.authorityCertificate else {
+            shareFile = nil
+            return
+        }
+        let file = FileManager.default.temporaryDirectory.appendingPathComponent(CertificateServer.fileName)
+        do {
+            try der.write(to: file, options: .atomic)
+            shareFile = file
+        } catch { shareFile = nil }
+    }
+
+    private func openSettings() {
+        guard let url = URL(string: UIApplication.openSettingsURLString) else { return }
+        UIApplication.shared.open(url)
+    }
+}
