+/// Diagnostics for the single supported LocalDevVPN method.
+private struct XSAdvancedView: View {
+    let arabic: Bool
+    @Environment(\.dismiss) private var dismiss
+    @StateObject private var pairing = PairingStore.shared
+    @State private var remotePort = ""
+    @State private var detectedPort: String?
+    @State private var portError: String?
+    @State private var scanning = false
+
+    private func tr(_ ar: String, _ en: String) -> String { arabic ? ar : en }
+
+    var body: some View {
+        NavigationStack {
+            List {
+                Section(tr("الجهاز", "Device")) {
+                    LabeledContent("iOS", value: UIDevice.current.systemVersion)
+                    LabeledContent(tr("ملف Pairing", "Pairing file"),
+                                   value: pairing.hasPairingFile ? tr("موجود", "Imported") : tr("غير موجود", "Missing"))
+                    LabeledContent("LocalDevVPN", value: TunnelController.loopbackReachable ? tr("متصل", "Connected") : tr("غير متصل", "Disconnected"))
+                    Button(tr("تحديث حالة الاتصال", "Refresh connection status")) {
+                        pairing.refresh()
+                    }
+                }
+                Section(tr("منفذ الاقتران عن بُعد", "Remote Pairing port")) {
+                    LabeledContent(tr("عنوان الاتصال", "Tunnel peer"), value: TunnelConfig.targetIP)
+                    LabeledContent(tr("المنفذ المستخدم", "Port used"),
+                                   value: String(RemotePairingPortDiscovery.shared.lastSelected))
+                    if let detectedPort {
+                        LabeledContent(tr("نتيجة البحث", "Bonjour discovery"), value: detectedPort)
+                    }
+                    Button {
+                        scanning = true
+                        Task {
+                            let ports = await RemotePairingPortDiscovery.shared.discover()
+                            detectedPort = ports.isEmpty
+                                ? tr("لم يتم العثور على منفذ", "No port discovered")
+                                : ports.map { String($0) }.joined(separator: ", ")
+                            scanning = false
+                        }
+                    } label: {
+                        if scanning { ProgressView() }
+                        else { Label(tr("اكتشاف المنفذ تلقائيًا", "Discover port automatically"), systemImage: "network") }
+                    }
+                    .disabled(scanning)
+
+                    Text(tr("إذا ما اشتغل التفعيل، تقدر تدخل منفذ Remote Pairing من إعدادات الشبكة المتقدمة. اتركه فارغًا للاكتشاف التلقائي (49152 احتياطيًا).",
+                            "If activation fails, enter the Remote Pairing port manually. Leave blank to discover automatically (49152 fallback)."))
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+
+                    HStack {
+                        TextField(tr("تلقائي", "Automatic"), text: $remotePort)
+                            .keyboardType(.numberPad)
+                        Button(tr("حفظ", "Save")) {
+                            let trimmed = remotePort.trimmingCharacters(in: .whitespacesAndNewlines)
+                            if trimmed.isEmpty {
+                                UserDefaults.standard.removeObject(forKey: RemotePairingPortDiscovery.overrideKey)
+                                portError = nil
+                            } else if let value = Int(trimmed), (1...65535).contains(value) {
+                                UserDefaults.standard.set(value, forKey: RemotePairingPortDiscovery.overrideKey)
+                                portError = nil
+                            } else {
+                                portError = tr("ادخل رقم منفذ بين 1 و 65535", "Enter a port between 1 and 65535")
+                                return
+                            }
+                            RemotePairingPortDiscovery.shared.invalidate()
+                        }
+                    }
+                    if let portError {
+                        Text(portError).font(.caption).foregroundStyle(.red)
+                    }
+                }
+                Section(tr("مهم", "Important")) {
+                    Text(tr("مجرد اتصال الـVPN أو حفظ الإحداثيات ما يعني أن نظام iOS استخدم الموقع الجديد. افحص الموقع من تطبيق الخرائط.",
+                            "A connected VPN or saved pin does not prove iOS adopted the new location. Verify with Maps."))
+                    Text(tr("إذا ما اشتغل التغيير: تحقق من الاقتران، وافتح LocalDevVPN واتصل من جديد، ثم ارجع وجرب.",
+                            "If the location doesn't change, check pairing, reconnect LocalDevVPN, and try again."))
+                }
+            }
+            .navigationTitle("XS Location")
+            .toolbar { ToolbarItem(placement: .confirmationAction) { Button(tr("تم", "Done")) { dismiss() } } }
+            .onAppear {
+                remotePort = RemotePairingPortDiscovery.manualPort.map { String($0) } ?? ""
+            }
+        }
+    }
+}
