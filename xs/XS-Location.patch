+    // MARK: - Actions
+
+    private var nextHint: String? {
+        if !pairing.hasPairingFile {
+            return tr("ابدأ بالاقتران من الخطوة 1", "Complete pairing in step 1 first")
+        }
+        if !vpnUp {
+            return tr("شغّل LocalDevVPN من الخطوة 2", "Connect LocalDevVPN in step 2")
+        }
+        if chosenLocation == nil {
+            return tr("اضغط على الخريطة لاختيار مكان", "Tap the map to choose a place")
+        }
