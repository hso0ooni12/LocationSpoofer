+    private func setupRow<Accessory: View>(
+        _ number: Int, title: String, description: String, success: Bool,
+        @ViewBuilder accessory: () -> Accessory
+    ) -> some View {
+        HStack(alignment: .top, spacing: 12) {
+            ZStack {
+                Circle().fill(success ? mint.opacity(0.12) : blue.opacity(0.09))
+                if success { Image(systemName: "checkmark").foregroundStyle(mint) }
+                else { Text("\(number)").foregroundStyle(blue) }
+            }
+            .font(.system(size: 13, weight: .bold))
+            .frame(width: 30, height: 30)
+
+            VStack(alignment: .leading, spacing: 4) {
+                Text(title).font(.system(size: 14, weight: .semibold))
+                Text(description)
+                    .font(.system(size: 12))
+                    .foregroundStyle(.secondary)
+                    .fixedSize(horizontal: false, vertical: true)
+                accessory().padding(.top, 4)
+            }
+            Spacer(minLength: 0)
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+    }
+
+    private var limitationNote: some View {
+        HStack(alignment: .top, spacing: 10) {
+            Image(systemName: "info.circle.fill").foregroundStyle(blue)
+            Text(method == .developer
+                 ? tr("محاكاة المطوّر تغيّر موقع النظام، لكن بعض التطبيقات قد تكتشف الموقع المحاكى أو ترفضه.",
+                      "Developer simulation changes system location, but some apps can detect or reject simulated fixes.")
+                 : tr("Network يغيّر تحديد الموقع عبر الواي فاي والأبراج فقط؛ قد يتغلب عليه GPS، وقد يحتاج iOS 26 إلى إعادة تشغيل بعد تغيير المكان.",
+                      "Network mode changes Wi-Fi/cell positioning only. GPS may override it and iOS 26 may need a restart to clear cached locations."))
+                .font(.system(size: 12))
+                .foregroundStyle(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+        }
+        .padding(13)
+    }
+
+    // MARK: - Actions
+
+    private var actionBar: some View {
+        HStack(spacing: 10) {
+            if session.isSpoofing {
+                Button {
+                    session.stop(pairing: pairing)
+                } label: {
+                    Label(tr("إيقاف واستعادة الموقع", "Stop and restore location"), systemImage: "stop.fill")
+                        .frame(maxWidth: .infinity)
+                        .frame(height: 52)
+                }
+                .buttonStyle(.borderedProminent)
+                .tint(Color(red: 0.83, green: 0.29, blue: 0.34))
+            } else {
+                Button {
+                    guard let chosenLocation else { return }
+                    SpoofBackend.current = method
+                    session.teleport(to: chosenLocation, pairing: pairing)
+                } label: {
+                    HStack(spacing: 9) {
+                        if session.isBusy { ProgressView().tint(.white) }
+                        else { Image(systemName: "location.fill") }
+                        Text(tr("تفعيل الموقع المختار", "Start location simulation"))
+                    }
+                    .font(.system(size: 15, weight: .bold))
+                    .frame(maxWidth: .infinity)
+                    .frame(height: 52)
+                }
+                .buttonStyle(.borderedProminent)
+                .tint(blue)
+                .disabled(session.isBusy || chosenLocation == nil)
+            }
+        }
+        .padding(.horizontal, 19)
+        .padding(.top, 12)
+        .padding(.bottom, 8)
+        .background(.regularMaterial)
+    }
+
+    private func sectionTitle(_ title: String, symbol: String) -> some View {
+        Label(title, systemImage: symbol)
+            .font(.system(size: 15, weight: .bold, design: .rounded))
+    }
+
+    private func initialize() {
+        // Two requested choices: never silently replace either with the
+        // TrollStore-only direct backend from the upstream application.
+        LocationBackend.prefersDirect = false
+        method = SpoofBackend.current == .network ? .network : .developer
+        SpoofBackend.current = method
+        refresh()
+        Task { await session.adoptNetworkSpoofIfRunning(pairing: pairing) }
+    }
+
+    private func refresh() {
+        pairing.refresh()
+        identity.refreshTrust()
+        vpnUp = TunnelController.loopbackReachable
+        if method == .network { Task { await network.refreshStatus() } }
+    }
+
+    @MainActor
+    private func searchPlace() async {
+        let query = searchText.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty else { return }
+        if let found = CoordinateParser.parse(query) {
+            showOnMap(found.coordinate)
+            return
+        }
+        searching = true
+        defer { searching = false }
+        let request = MKLocalSearch.Request()
+        request.naturalLanguageQuery = query
+        do {
+            let result = try await MKLocalSearch(request: request).start()
+            guard let coordinate = result.mapItems.first?.placemark.coordinate else {
+                searchError = tr("ما حصلت نتيجة؛ جرّب اسم مدينة أخرى", "No result. Try another city or address.")
+                return
+            }
+            showOnMap(coordinate)
+        } catch {
+            searchError = error.localizedDescription
+        }
+    }
+
+    private func showOnMap(_ coordinate: CLLocationCoordinate2D) {
+        session.setPin(coordinate)
+        camera = .region(MKCoordinateRegion(center: coordinate,
+            span: MKCoordinateSpan(latitudeDelta: 0.02, longitudeDelta: 0.02)))
+        searchFocused = false
+    }
+}
