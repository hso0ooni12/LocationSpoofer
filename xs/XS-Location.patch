diff --git a/Locus/Engine/RemotePairingPortDiscovery.swift b/Locus/Engine/RemotePairingPortDiscovery.swift
new file mode 100644
index 0000000..3a396c9
--- /dev/null
+++ b/Locus/Engine/RemotePairingPortDiscovery.swift
@@ -0,0 +1,152 @@
+import Foundation
+import Network
+
+/// iOS 27 can advertise remotepairingd on an ephemeral TCP port instead of
+/// 49152. Discover it using the same Bonjour service as the host-side tools.
+/// The user can supply an override in the diagnostics sheet if mDNS is blocked.
+@MainActor
+final class RemotePairingPortDiscovery: NSObject, NetServiceBrowserDelegate, NetServiceDelegate {
+    static let shared = RemotePairingPortDiscovery()
+    static let overrideKey = "xs.remotePairingPort"
+    static let legacyPort: UInt16 = 49152
+
+    private var browser: NetServiceBrowser?
+    private var services: [NetService] = []
+    private var found: Set<UInt16> = []
+    private var continuation: CheckedContinuation<[UInt16], Never>?
+    private var timeoutTask: Task<Void, Never>?
+
+    private(set) var lastDiscovered: [UInt16] = []
+    private(set) var lastSelected: UInt16 = legacyPort
+    private var cachedPeer: String?
+    private var cachedPorts: [UInt16] = []
+    private var cachedOverride: UInt16?
+
+    static var manualPort: UInt16? {
+        let value = UserDefaults.standard.integer(forKey: overrideKey)
+        guard (1...65535).contains(value) else { return nil }
+        return UInt16(value)
+    }
+
+    func discover(timeout: TimeInterval = 3.5) async -> [UInt16] {
+        // A single browser at a time, including the user-triggered diagnostics.
+        guard continuation == nil else { return lastDiscovered }
+        return await withCheckedContinuation { continuation in
+            self.continuation = continuation
+            self.found.removeAll()
+            self.services.removeAll()
+
+            let browser = NetServiceBrowser()
+            browser.delegate = self
+            self.browser = browser
+            browser.searchForServices(ofType: "_remotepairing._tcp.", inDomain: "local.")
+
+            timeoutTask = Task { @MainActor in
+                try? await Task.sleep(nanoseconds: UInt64(timeout * 1_000_000_000))
+                finish()
+            }
+        }
+    }
+
+    func netServiceBrowser(_ browser: NetServiceBrowser, didFind service: NetService, moreComing: Bool) {
+        service.delegate = self
+        services.append(service)
+        service.resolve(withTimeout: 2.5)
+    }
+
+    func netServiceDidResolveAddress(_ sender: NetService) {
+        guard (1...65535).contains(sender.port) else { return }
+        found.insert(UInt16(sender.port))
+        // Let the browser run until its short timeout to include other devices.
+    }
+
+    func netServiceBrowser(_ browser: NetServiceBrowser, didNotSearch errorDict: [String: NSNumber]) {
+        finish()
+    }
+
+    func netServiceBrowserDidStopSearch(_ browser: NetServiceBrowser) {
+        // `finish()` calls stop; never resume the continuation twice.
+    }
+
+    private func finish() {
+        guard let continuation else { return }
+        self.continuation = nil
+        timeoutTask?.cancel()
+        timeoutTask = nil
+        browser?.stop()
+        browser = nil
+        services.forEach { $0.stop() }
+        services.removeAll()
+        lastDiscovered = found.sorted()
+        continuation.resume(returning: lastDiscovered)
+    }
+
+    /// Prefer ports that actually accept TCP on the loopback peer. A VPN icon
+    /// and an IPv4 utun address alone don't establish this readiness.
+    func candidatePorts(peerIP: String) async -> [UInt16] {
+        // Routes send several fixes per second. The port may be discovered once
+        // per connection, not before every location update.
+        if cachedPeer == peerIP, !cachedPorts.isEmpty,
+           cachedOverride == Self.manualPort {
+            return cachedPorts
+        }
+        let advertised: [UInt16]
+        if let manual = Self.manualPort {
+            advertised = [manual]
+        } else {
+            advertised = await discover()
+        }
+
+        var candidates = advertised
+        if !candidates.contains(Self.legacyPort) { candidates.append(Self.legacyPort) }
+
+        var responding: [UInt16] = []
+        for port in candidates {
+            if await RemotePairingPortProbe.acceptsTCP(host: peerIP, port: port) {
+                responding.append(port)
+            }
+        }
+
+        // If every probe failed, still attempt the best candidate through
+        // idevice: Network.framework can report a transient false negative.
+        let selected = responding.isEmpty ? [candidates[0]] : responding
+        lastSelected = selected[0]
+        cachedPeer = peerIP
+        cachedPorts = selected
+        cachedOverride = Self.manualPort
+        return selected
+    }
+
+    func invalidate() {
+        cachedPeer = nil
+        cachedPorts = []
+    }
+}
+
+/// Keeps a single TCP probe bounded at 1.5s. All its callbacks run on one
+/// private serial queue so the continuation is only resumed once.
+private enum RemotePairingPortProbe {
+    static func acceptsTCP(host: String, port: UInt16) async -> Bool {
+        guard let endpointPort = NWEndpoint.Port(rawValue: port) else { return false }
+        return await withCheckedContinuation { continuation in
+            let queue = DispatchQueue(label: "com.hso0ooni.xslocation.port-probe")
+            let connection = NWConnection(host: NWEndpoint.Host(host), port: endpointPort, using: .tcp)
+            var finished = false
+            let complete: (Bool) -> Void = { success in
+                guard !finished else { return }
+                finished = true
+                connection.cancel()
+                continuation.resume(returning: success)
+            }
+            connection.stateUpdateHandler = { state in
+                switch state {
+                case .ready: complete(true)
+                case .failed, .cancelled: complete(false)
+                default: break
+                }
+            }
+            connection.start(queue: queue)
+            queue.asyncAfter(deadline: .now() + 1.5) { complete(false) }
+        }
+    }
+}
