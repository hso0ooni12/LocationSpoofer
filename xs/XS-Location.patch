-  # can't test on a phone, and this app only really works on one.
-  #
-  # No `pull_request:` trigger — a PR from a branch in this repo would build the
-  # same commit twice, and the push event is the one that can publish.
-  push:
-    branches: ["**"]
-    tags: ["v*"]
-    # A push that only touches prose has nothing to build. (Path filters don't
-    # apply to tag pushes, so a release tag always builds.)
