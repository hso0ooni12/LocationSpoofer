+                         description: tr("تغيّر خدمة المحاكاة موقع النظام للتطبيقات المتوافقة", "The developer service simulates system location for compatible apps"),
+                         success: session.isSpoofing) { EmptyView() }
+            } else {
+                setupRow(1, title: tr("تحقق من صلاحية VPN", "Check VPN capability"),
+                         description: TunnelController.staticBlocker == nil
+                             ? tr("صلاحية الاتصال المدمج قيد التحقق", "Built-in tunnel capability can be tested")
+                             : tr("التوقيع ما يتيح تشغيل النفق المدمج", "Current signature can't run the built-in tunnel"),
+                         success: TunnelController.staticBlocker == nil) { EmptyView() }
+                setupRow(2, title: tr("ثبّت شهادة الاتصال", "Install network certificate"),
+                         description: identity.trust == .trusted ? tr("الشهادة موثوقة", "Certificate trusted") : tr("التثبيت والثقة من إعدادات iOS", "Install and trust it in iOS Settings"),
+                         success: identity.trust == .trusted) {
+                    Button(tr("إعداد الشهادة", "Certificate setup")) { showNetworkSetup = true }
+                        .buttonStyle(.bordered)
+                        .controlSize(.small)
+                }
+                setupRow(3, title: tr("افحص الاتصال", "Run connection checks"),
+                         description: tr("يفحص الشهادة والنفق وDNS والبروكسي", "Tests certificate, tunnel, DNS and proxy"),
+                         success: network.checks.count == 4 && network.checks.allSatisfy({
+                             if case .passed = $0 { return true }
+                             return false
+                         })) {
+                    Button(tr("فحص", "Test")) { Task { await network.runChecks() } }
+                        .buttonStyle(.bordered)
+                        .controlSize(.small)
+                        .disabled(network.isChecking || TunnelController.staticBlocker != nil)
+                }
