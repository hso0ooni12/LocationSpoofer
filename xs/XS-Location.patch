+                    .font(.system(size: 12, weight: .medium))
+                    .foregroundStyle(.secondary)
+            }
+            HStack(spacing: 10) {
+                if session.isSpoofing {
+                    Button {
+                        session.stop(pairing: pairing)
+                    } label: {
+                        Label(tr("إيقاف واستعادة الموقع", "Stop and restore location"), systemImage: "stop.fill")
