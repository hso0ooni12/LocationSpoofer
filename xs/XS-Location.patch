+                setupRow(2, title: tr("شغّل LocalDevVPN", "Connect LocalDevVPN"),
+                         description: vpnUp ? tr("النفق المحلي جاهز", "Local tunnel is available") : tr("حمّل التطبيق من App Store واتصل", "Install from App Store and connect"),
